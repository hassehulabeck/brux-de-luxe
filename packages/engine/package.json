{
  "name": "@brux/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure rules engine and bot AI for Bruxelles 1893. No runtime dependencies, no DOM, no Node APIs.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
