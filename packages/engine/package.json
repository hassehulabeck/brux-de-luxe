    "test:watch": "vitest",
    "test:data": "CHECK_DATA=1 vitest run test/data"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
